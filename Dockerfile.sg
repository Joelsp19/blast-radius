FROM br-base
RUN apt-get update -qq && apt-get install -y -qq git >/dev/null && \
    git init -q /opt/sqlglot && cd /opt/sqlglot && \
    git remote add origin https://github.com/tobymao/sqlglot.git && \
    git fetch -q --depth 1 origin eb11aec4be8cb2122afe713a4816662c3f0fb2fa && \
    git checkout -q FETCH_HEAD && rm -rf .git
ENV PYTHONPATH=/opt/sqlglot SKIP_INTEGRATION=0
WORKDIR /opt/sqlglot
